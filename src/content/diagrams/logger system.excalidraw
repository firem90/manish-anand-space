      "boundElements": [],
      "updated": 1769163089307,
      "link": null,
      "locked": false,
      "text": "interface LogHandler {\n    void handle(String message);\n    void flush();\n}\n\nclass FileHandler implements LogHandler {\n    public void handle(String msg) { /* writes to buffer */ }\n    public void flush() { /* writes buffer to file */ }\n}\n\nclass ConsoleHandler implements LogHandler {\n    public void handle(String msg) { System.out.println(msg); }\n    public void flush() { \n        // Console doesn't need flush... what do we do?\n        throw new UnsupportedOperationException(\"Console doesn't flush!\");\n    }\n}",
      "fontSize": 34.38255068189412,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface LogHandler {\n    void handle(String message);\n    void flush();\n}\n\nclass FileHandler implements LogHandler {\n    public void handle(String msg) { /* writes to buffer */ }\n    public void flush() { /* writes buffer to file */ }\n}\n\nclass ConsoleHandler implements LogHandler {\n    public void handle(String msg) { System.out.println(msg); }\n    public void flush() { \n        // Console doesn't need flush... what do we do?\n        throw new UnsupportedOperationException(\"Console doesn't flush!\");\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
