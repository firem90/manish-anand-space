    {
      "id": "u-9A9JZrM7-FdLZvrrtW_",
      "type": "text",
      "x": 9144.971571126316,
      "y": 1944.7242703560873,
      "width": 1358.8686871954624,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "cZT_OS_e3NU-T7StfxYcD",
        "mXOcnTAQ39BBF2OjiJ_Yx"
      ],
      "frameId": null,
      "index": "b7y",
      "roundness": null,
      "seed": 868275602,
      "version": 413,
      "versionNonce": 1823260494,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769164007987,
      "link": null,
      "locked": false,
      "text": "// Without Singleton - chaos!\nclass ConfigManager {\n    private Map<String, String> configs;\n    \n    public ConfigManager() {\n        // Loads config from file EVERY time\n        this.configs = loadFromFile(\"config.yml\");\n    }\n}\n\n// Usage - multiple instances, wasted resources, inconsistent state\nConfigManager config1 = new ConfigManager();  // Loads file\nConfigManager config2 = new ConfigManager();  // Loads again!\nconfig1.set(\"timeout\", \"30\");\nconfig2.get(\"timeout\");  // Still old value! Inconsistent!",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Without Singleton - chaos!\nclass ConfigManager {\n    private Map<String, String> configs;\n    \n    public ConfigManager() {\n        // Loads config from file EVERY time\n        this.configs = loadFromFile(\"config.yml\");\n    }\n}\n\n// Usage - multiple instances, wasted resources, inconsistent state\nConfigManager config1 = new ConfigManager();  // Loads file\nConfigManager config2 = new ConfigManager();  // Loads again!\nconfig1.set(\"timeout\", \"30\");\nconfig2.get(\"timeout\");  // Still old value! Inconsistent!",
      "autoResize": false,
      "lineHeight": 1.25
    },
