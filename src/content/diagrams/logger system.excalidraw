      "updated": 1769169419209,
      "link": null,
      "locked": false,
      "text": "✅ USE SINGLETON WHEN: \n    • Truly stateless (Logger) \n    • Read-only after initialization (Config) \n    • Resource pool (Thread pool, Connection pool) \n    • Hardware interface (Printer spooler)",
      "fontSize": 55.84858473393106,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ USE SINGLETON WHEN: \n    • Truly stateless (Logger) \n    • Read-only after initialization (Config) \n    • Resource pool (Thread pool, Connection pool) \n    • Hardware interface (Printer spooler)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "J_KrcfusuW4KOGtx2zW2T",
      "type": "text",
      "x": 13244.397991526463,
      "y": 2987.9556769384444,
      "width": 1529.2105805427814,
      "height": 339.58319839872775,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAy",
      "roundness": null,
      "seed": 987002446,
      "version": 766,
      "versionNonce": 830478670,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769169419209,
      "link": null,
      "locked": false,
      "text": "❌ AVOID SINGLETON WHEN: \n    • State changes during runtime \n    • Need to test the class in isolation\n    • Multiple configurations needed (per-tenant, per-env) \n    • Dependencies should be explicit",
      "fontSize": 54.333311743796436,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "❌ AVOID SINGLETON WHEN: \n    • State changes during runtime \n    • Need to test the class in isolation\n    • Multiple configurations needed (per-tenant, per-env) \n    • Dependencies should be explicit",
      "autoResize": true,
      "lineHeight": 1.25
    },
