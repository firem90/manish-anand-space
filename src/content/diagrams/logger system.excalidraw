      "isDeleted": false,
      "boundElements": [],
      "updated": 1769165615513,
      "link": null,
      "locked": false,
      "text": "Imagine hiring someone for a job. Their resume says\n\"No requirements.\"\nDay 1: \"Oh, I also need a car.\"\nDay 2: \"Oh, I also need a laptop.\"\nDay 3: \"Oh, I also need access to the database.\"\nThat's hidden dependencies.",
      "fontSize": 57.365085283341585,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Imagine hiring someone for a job. Their resume says \"No requirements.\"\nDay 1: \"Oh, I also need a car.\"\nDay 2: \"Oh, I also need a laptop.\"\nDay 3: \"Oh, I also need access to the database.\"\nThat's hidden dependencies.",
