      "type": "text",
      "x": 9199.771613043662,
      "y": 2949.9728936773636,
      "width": 1029.3706978601674,
      "height": 749.9451569414076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
