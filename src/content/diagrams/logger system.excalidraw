      "frameId": null,
      "index": "b8e",
      "roundness": null,
      "seed": 496981966,
      "version": 943,
      "versionNonce": 779233742,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "RvOzrXOa68lWSKrJQe_WD",
          "type": "arrow"
        }
      ],
      "updated": 1769164042870,
      "link": null,
      "locked": false,
      "text": "class ConfigManager {\n    \n    private static ConfigManager instance;\n    \n    private ConfigManager() {\n        this.configs = loadFromFile(\"config.yml\");\n    }\n    public static ConfigManager getInstance() {\n        if (instance == null) {\n            instance = new ConfigManager();\n        }\n        return instance;\n    }\n    \n    private Map<String, String> configs;\n    public String get(String key) {\n        return configs.get(key);\n    }\n    public void set(String key, String value) {\n        configs.put(key, value);\n    }\n}",
      "fontSize": 27.27073297968755,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class ConfigManager {\n    \n    private static ConfigManager instance;\n    \n    private ConfigManager() {\n        this.configs = loadFromFile(\"config.yml\");\n    }\n    public static ConfigManager getInstance() {\n        if (instance == null) {\n            instance = new ConfigManager();\n        }\n        return instance;\n    }\n    \n    private Map<String, String> configs;\n    public String get(String key) {\n        return configs.get(key);\n    }\n    public void set(String key, String value) {\n        configs.put(key, value);\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
