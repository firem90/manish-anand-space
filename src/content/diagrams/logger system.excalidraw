    {
      "id": "L9Kwxkp1Yfv_kVOaRrBCe",
      "type": "text",
      "x": 9135.64781538744,
      "y": 1643.8156638846353,
      "width": 2072.0962585159346,
      "height": 142.73573193341883,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "mXOcnTAQ39BBF2OjiJ_Yx"
      ],
      "frameId": null,
      "index": "b7v",
      "roundness": null,
      "seed": 1941964370,
      "version": 455,
      "versionNonce": 2088066190,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769164007987,
      "link": null,
      "locked": false,
      "text": "“Singleton ensures that only one instance of a class exists and provides\na global access point.”",
      "fontSize": 57.09429277336753,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“Singleton ensures that only one instance of a class exists and provides a global access point.”",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Xaxinnrp9hilbRBaQO4Dg",
