      "isDeleted": false,
      "boundElements": [],
      "updated": 1769164007987,
      "link": null,
      "locked": false,
      "text": "“Singleton is useful when exactly one instance must coordinate actions system-wide.”",
      "fontSize": 45.84622314525928,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“Singleton is useful when exactly one instance must coordinate actions system-wide.”",
      "autoResize": false,
      "lineHeight": 1.25
    },
