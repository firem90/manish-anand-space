      "text": "if (instance == null) { \n      synchronized(lock) { \n            if (instance == null) { \n                   instance = new();\n            }\n        }\n}\n",
      "fontSize": 24.477283983424563,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if (instance == null) { \n      synchronized(lock) { \n            if (instance == null) { \n                   instance = new();\n            }\n        }\n}\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
