      "isDeleted": false,
      "boundElements": [],
      "updated": 1769169075532,
      "link": null,
      "locked": false,
      "text": "Imagine a shared TV remote\nin a house with 5 people.\nYou set it to Channel 5.\nCome back - it's on Channel\n99.\nWho changed it? When? Why?\nGlobal state = anyone can\nchange it, no one knows who\ndid.",
      "fontSize": 73.43283545492936,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Imagine a shared TV remote in a house with 5 people.\nYou set it to Channel 5.\nCome back - it's on Channel 99.\nWho changed it? When? Why?\nGlobal state = anyone can change it, no one knows who did.",
      "autoResize": false,
      "lineHeight": 1.25
    },
