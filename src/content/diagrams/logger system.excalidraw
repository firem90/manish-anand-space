      "isDeleted": false,
      "boundElements": [],
      "updated": 1769164007987,
      "link": null,
      "locked": false,
      "text": "“Creational patterns answer one question: How should\nobjects be created and who controls that creation?”",
      "fontSize": 90.7402717080543,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“Creational patterns answer one question: How should objects be created and who controls that creation?”",
      "autoResize": false,
      "lineHeight": 1.25
    },
